# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: your sandbox merchant's payer ID; captures paid to anyone else are rejected
PAYPAL_MERCHANT_ID=

# Jev (TypeSafe) API key: https://typesafe.ai
TYPESAFE_API_KEY=
# Optional: Claude Haiku suggests remedies from your store listings (merchant approves each one).
# Leave empty to turn suggestions off.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace: the workspace ID (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
JEV_MODEL=jev-preview

# Merchant console sign-in, and the cookie signing secret (32+ random characters)
MERCHANT_PASSWORD=
SESSION_SECRET=

# Earlier requests on other orders that flag a buyer as a repeat claimant (0 turns the flag off,
# useful when every demo run uses the same sandbox buyer)
REPEAT_CLAIM_LIMIT=1

PORT=8888
APP_BASE_URL=http://localhost:8888
DATABASE_PATH=data/refund-relay.db
UPLOAD_DIR=data/uploads

# Behind a load balancer (Render, Fly, nginx): how many proxy hops to trust for the client IP.
# Without it every buyer shares one rate-limit bucket.
TRUST_PROXY=
# Copy the database to <data>/backups every N hours and keep the newest BACKUP_KEEP copies (0 = off)
BACKUP_INTERVAL_HOURS=0
BACKUP_KEEP=7
# One JSON line per API request on stdout (0 = off)
LOG_REQUESTS=1

# Scale limits (defaults shown). Jev looks at up to AI_MAX_PHOTOS of a claim's photos per call.
MAX_PHOTOS=100
MAX_UPLOAD_MB=15
MAX_REQUEST_MB=300
AI_MAX_PHOTOS=8
JEV_CONCURRENCY=4
IMAGE_CONCURRENCY=4

# Hosted demo for judges: 1 prints the merchant password on the sign-in screen and the buyer
# sign-in below under the PayPal button (sandbox accounts only)
PUBLIC_DEMO=0
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# Only for scripts/e2e-sandbox.js: a sandbox Personal (buyer) account
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
